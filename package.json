{
  "name": "cfb-prospect-report",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "sync:rosters": "tsx --env-file-if-exists=.env.local scripts/syncRosters.ts",
    "update:history": "tsx --env-file-if-exists=.env.local scripts/updateHistory.ts",
    "backtest": "tsx --env-file-if-exists=.env.local scripts/backtest.ts",
    "record:fixtures": "tsx --env-file-if-exists=.env.local scripts/recordFixtures.ts",
    "tune:weights": "tsx --env-file-if-exists=.env.local scripts/tuneWeights.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "cfbd": "^5.31.2",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
