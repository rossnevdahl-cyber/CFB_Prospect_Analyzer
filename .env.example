# Copy to .env.local for local development. In production set these in Vercel and GitHub Actions secrets.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # Neon pooled connection string
CFBD_API_KEY=                                               # collegefootballdata.com
YOUTUBE_API_KEY=                                            # Google Cloud, YouTube Data API v3
APP_PASSWORD=                                               # single-user password

